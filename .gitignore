# Publish only the standalone web edition. Local build and research copies are
# deliberately outside this manifest, even when present beside the source.
/*
!/.gitignore
!/.github/
!/AGENTS.md
!/README.md
!/README.zh-CN.md
!/THIRD_PARTY_NOTICES.md
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json
!/vite.config.ts
!/playwright.international.config.ts
!/index.html
!/src/
!/public/
!/models/
!/e2e/
!/docs/
/src/previews/
/src/test/*
!/src/test/fixtures.ts
!/src/test/match-fixtures.ts
!/src/test/fixtures/
!/src/test/international.test.ts
!/src/test/patterns.test.ts
!/src/test/state.test.ts
!/src/test/persistence.test.ts
!/src/test/classic-rules.test.ts
!/src/test/classic-session.test.ts
!/src/test/arrangement.test.ts
!/src/test/cardMove.test.ts
!/src/test/verticalGroups.test.ts
!/src/test/archive-replay.test.ts
!/src/test/replay-navigation.test.ts
!/src/test/player-tiers.test.ts
/src/test/fixtures/endgame/
/src/test/fixtures/pro-public-finish-protected-baseline.json
/models/*
!/models/pro/
!/models/jwxxc/
/models/pro/candidates/
/e2e/*
!/e2e/international.spec.ts
!/e2e/verticalHandFixtures.ts
/docs/*
!/docs/RULES_CLASSIC_V1.md
!/docs/MATCH_RULES.md
